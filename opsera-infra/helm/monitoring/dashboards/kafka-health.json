{
  "title": "Opsera Kafka Cluster Health",
  "uid": "opsera-kafka-health",
  "tags": ["opsera", "kafka", "infrastructure"],
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Broker Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "kafka_controller_activecontrollercount", "legendFormat": "Active Controllers" }]
    },
    {
      "id": 2,
      "title": "Under-Replicated Partitions",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(kafka_server_replicamanager_underreplicatedpartitions)", "legendFormat": "Under-replicated" }],
      "thresholds": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }]
    },
    {
      "id": 3,
      "title": "Consumer Lag per Topic/Group",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "targets": [{
        "expr": "sum(kafka_consumergroup_lag) by (topic, consumergroup)",
        "legendFormat": "{{topic}} / {{consumergroup}}"
      }]
    },
    {
      "id": 4,
      "title": "Messages In per Second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(kafka_server_brokertopicmetrics_messagesin_total[5m])) by (topic)",
        "legendFormat": "{{topic}}"
      }]
    },
    {
      "id": 5,
      "title": "DLQ Message Count",
      "type": "stat",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(kafka_consumergroup_lag{topic=~\".*\\.dlq\"}) by (topic)",
        "legendFormat": "{{topic}} DLQ lag"
      }],
      "thresholds": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }]
    }
  ]
}
