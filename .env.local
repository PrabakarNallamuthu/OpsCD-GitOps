# Local development environment variables
# Used by all services when started via start-local.sh

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opsera
POSTGRES_PASSWORD=opsera_local

# Per-service DATABASE_URL (override per service in start-local.sh)
DATABASE_URL_AUTH=postgresql://opsera:opsera_local@localhost:5432/opsera_auth
DATABASE_URL_RELEASE=postgresql://opsera:opsera_local@localhost:5432/opsera_release
DATABASE_URL_AUDIT=postgresql://opsera:opsera_local@localhost:5432/opsera_audit
DATABASE_URL_ANALYTICS=postgresql://opsera:opsera_local@localhost:5432/opsera_analytics
DATABASE_URL_RISK=postgresql://opsera:opsera_local@localhost:5432/opsera_risk
DATABASE_URL_POLICY=postgresql://opsera:opsera_local@localhost:5432/opsera_policy
DATABASE_URL_VERIFICATION=postgresql://opsera:opsera_local@localhost:5432/opsera_verification

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=opsera-local

# JWT / Auth
JWT_SECRET=local-dev-jwt-secret-minimum-32-chars!!
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
OIDC_ISSUER=http://localhost:3001

# Service ports
AUTH_SERVICE_PORT=3001
RELEASE_SERVICE_PORT=3002
AUDIT_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
RISK_ENGINE_PORT=3005
POLICY_ENGINE_PORT=3006
VERIFICATION_SERVICE_PORT=3007
BFF_PORT=3008

# Frontend
VITE_API_URL=http://localhost:3008/api/v1
VITE_AUTH_URL=http://localhost:3001

# MinIO (skip for local dev without docker)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=opsera_local
MINIO_SECRET_KEY=opsera_local_secret

# Vault (skip for local dev)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=local-dev-token

# Node
NODE_ENV=development
LOG_LEVEL=debug
