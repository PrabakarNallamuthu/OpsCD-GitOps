generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["risk"]
}

enum RiskLevel {
  Low
  Medium
  High
  Critical

  @@schema("risk")
}

enum Recommendation {
  Go
  GoWithConditions
  NoGo

  @@schema("risk")
}

enum FindingSeverity {
  Low
  Medium
  High
  Critical

  @@schema("risk")
}

enum ResolutionStatus {
  Open
  Acknowledged
  Resolved

  @@schema("risk")
}

model RiskAssessment {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  release_id    String          @db.Uuid
  score         Int             // 0–100
  risk_level    RiskLevel
  recommendation Recommendation
  ai_summary    String          @db.Text
  finding_count Int             @default(0)
  duration_ms   Int?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)

  findings      RiskFinding[]
  dimensions    ScoreDimension[]

  @@index([release_id])
  @@index([created_at(sort: Desc)])
  @@schema("risk")
}

model RiskFinding {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assessment_id       String           @db.Uuid
  severity            FindingSeverity
  category            String           @db.VarChar(100)
  description         String           @db.Text
  affected_component  String?          @db.VarChar(200)
  resolution_status   ResolutionStatus @default(Open)
  metadata            Json?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)

  assessment          RiskAssessment   @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@index([assessment_id, severity])
  @@schema("risk")
}

model ScoreDimension {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assessment_id  String         @db.Uuid
  dimension_name String         @db.VarChar(100)
  raw_score      Int
  weight         Decimal        @db.Decimal(4, 3)
  weighted_score Decimal        @db.Decimal(6, 3)
  metadata       Json?
  created_at     DateTime       @default(now()) @db.Timestamptz(6)

  assessment     RiskAssessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@index([assessment_id])
  @@schema("risk")
}
