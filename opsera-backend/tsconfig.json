{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@opsera/shared": ["packages/shared/src/index.ts"],
      "@opsera/shared/*": ["packages/shared/src/*"],
      "@opsera/logging": ["packages/logging/src/index.ts"],
      "@opsera/logging/*": ["packages/logging/src/*"],
      "@opsera/kafka": ["packages/kafka/src/index.ts"],
      "@opsera/kafka/*": ["packages/kafka/src/*"],
      "@opsera/prisma-config": ["packages/prisma-config/src/index.ts"],
      "@opsera/prisma-config/*": ["packages/prisma-config/src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
