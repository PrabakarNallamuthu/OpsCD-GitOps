{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "com.opsera.release.created.v1",
  "title": "ReleaseCreated",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "release.created" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "timestamp": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "actorId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["releaseId", "name", "version", "environment"],
      "additionalProperties": false,
      "properties": {
        "releaseId": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "environment": { "type": "string" },
        "gitRef": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
