// Reference Prisma schema demonstrating canonical patterns for all Opsera services.
// Each service creates its own schema file pointing to its dedicated PostgreSQL schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "release", "risk", "policy", "audit", "verification", "analytics"]
}

// ─── Canonical Table Pattern Example ─────────────────────────────────────────
// All domain tables follow this structure:
//   - UUID primary key (generated by PostgreSQL uuid_generate_v4)
//   - created_at / updated_at managed by Prisma @updatedAt
//   - deleted_at for soft-delete (null = active)
//   - created_by / updated_by for audit trail

model User {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email      String    @unique @db.VarChar(500)  // stores encrypted email
  name       String    @db.VarChar(500)          // stores encrypted name
  roles      String[]  @db.Text
  org_id     String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@schema("auth")
  @@index([org_id])
  @@index([deleted_at])
}

model Environment {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String    @db.VarChar(100)
  slug       String    @unique @db.VarChar(100)
  tier       String    @db.VarChar(20) // dev | staging | production
  org_id     String    @db.Uuid
  config     Json      @default("{}")
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@schema("release")
  @@index([org_id, slug])
}
